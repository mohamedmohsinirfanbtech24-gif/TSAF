    "import matplotlib.pyplot as plt\n",
    "\n",
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "\n",
    "from IPython.display import display\n",
    "\n",
    "print(\"All libraries imported successfully!\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 1: Load the dataset\n",
    "\n",
    "# ============================================================\n",
    "\n",
    "file_path = r\"C:\\Users\\mohsi\\Downloads\\mauna_loa_co2_monthly_mean_data.csv\"\n",
    "\n",
    "# The actual column names are present after the metadata\n",
    "df = pd.read_csv(\n",
    "    file_path,\n",
    "    skiprows=40\n",
    ")\n",
    "\n",
    "print(\"Dataset loaded successfully!\")\n",
    "\n",
    "print(\"\\nFirst 5 rows:\")\n",
    "display(df.head())\n",
    "\n",
    "print(\"\\nLast 5 rows:\")\n",
    "display(df.tail())\n",
    "\n",
    "print(\"\\nShape:\")\n",
    "print(df.shape)\n",
    "\n",
    "print(\"\\nColumn names:\")\n",
    "print(df.columns)\n",
    "\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Prepare the data\n",
    "# ============================================================\n",
    "\n",
    "# Convert year and month to numeric\n",
    "df[\"year\"] = pd.to_numeric(df[\"year\"], errors=\"coerce\")\n",
    "df[\"month\"] = pd.to_numeric(df[\"month\"], errors=\"coerce\")\n",
    "df[\"average\"] = pd.to_numeric(df[\"average\"], errors=\"coerce\")\n",
    "\n",
    "# Remove any invalid rows\n",
    "df.dropna(subset=[\"year\", \"month\", \"average\"], inplace=True)\n",
    "\n",
    "# Create datetime index\n",
    "df[\"Date\"] = pd.to_datetime(\n",
    "    dict(\n",
    "        year=df[\"year\"].astype(int),\n",
    "        month=df[\"month\"].astype(int),\n",
    "        day=1\n",
    "    )\n",
    ")\n",
    "\n",
    "# Set Date as index\n",
    "df.set_index(\"Date\", inplace=True)\n",
    "\n",
    "# Sort by date\n",
    "df.sort_index(inplace=True)\n",
    "\n",
    "# CO2 time series\n",
    "co2 = df[\"average\"]\n",
    "\n",
    "print(\"\\nPreprocessed data:\")\n",
    "display(df.head())\n",
    "\n",
    "print(\"\\nNumber of observations:\")\n",
    "print(len(co2))\n",
    "\n",
    "print(\"\\nDate range:\")\n",
    "print(co2.index.min(), \"to\", co2.index.max())\n",
    "\n",
    "print(\"\\nMissing values:\")\n",
    "print(co2.isnull().sum())\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 2: Plot complete CO2 series\n",
    "# ============================================================\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "\n",
    "plt.plot(\n",
    "    co2.index,\n",
    "    co2,\n",
    "    linewidth=1.5\n",
    ")\n",
    "\n",
    "plt.title(\"Monthly Atmospheric CO₂ Concentration\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"CO₂ Concentration (ppm)\")\n",
    "plt.grid(True)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 3: Calculate 12-month moving average\n",
    "# ============================================================\n",
    "\n",
    "moving_average = co2.rolling(window=12).mean()\n",
    "\n",
    "print(\"\\n12-Month Moving Average:\")\n",
    "display(moving_average.head(20))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 4: Plot moving average\n",
    "# ============================================================\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "\n",
    "plt.plot(\n",
    "    co2.index,\n",
    "    co2,\n",
    "    linewidth=1,\n",
    "    label=\"Monthly CO₂\"\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    moving_average.index,\n",
    "    moving_average,\n",
    "    linewidth=2,\n",
    "    label=\"12-Month Moving Average\"\n",
    ")\n",
    "\n",
    "plt.title(\"Monthly CO₂ Concentration with 12-Month Moving Average\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"CO₂ Concentration (ppm)\")\n",
    "\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 5: Perform seasonal decomposition\n",
    "# ============================================================\n",
    "\n",
    "seasonal_period = 12\n",
    "\n",
    "print(\"Seasonal period:\", seasonal_period)\n",
    "print(\"Reason: The data is monthly and one year contains 12 months.\")\n",
    "\n",
    "decomposition = seasonal_decompose(\n",
    "    co2,\n",
    "    model=\"additive\",\n",
    "    period=12\n",
    ")\n",
    "\n",
    "print(\"Decomposition completed successfully!\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 6: Plot four components\n",
    "# ============================================================\n",
    "\n",
    "fig = decomposition.plot()\n",
    "\n",
    "fig.set_size_inches(14, 10)\n",
    "\n",
    "plt.suptitle(\n",
    "    \"Time Series Decomposition of Monthly CO₂ Concentration\",\n",
    "    y=1.02\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Display individual components\n",
    "# ============================================================\n",
    "\n",
    "observed = decomposition.observed\n",
    "trend = decomposition.trend\n",
    "seasonal = decomposition.seasonal\n",
    "residual = decomposition.resid\n",
    "\n",
    "print(\"\\nObserved component:\")\n",
    "display(observed.head(10))\n",
    "\n",
    "print(\"\\nTrend component:\")\n",
    "display(trend.head(15))\n",
    "\n",
    "print(\"\\nSeasonal component:\")\n",
    "display(seasonal.head(15))\n",
    "\n",
    "print(\"\\nResidual component:\")\n",
    "display(residual.head(15))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 8: Average seasonal effect for each month\n",
    "# ============================================================\n",
    "\n",
    "seasonal_df = pd.DataFrame({\n",
    "    \"Seasonal\": seasonal\n",
    "})\n",
    "\n",
    "seasonal_df[\"Month\"] = seasonal_df.index.month\n",
    "\n",
    "average_seasonal_effect = (\n",
    "    seasonal_df\n",
    "    .groupby(\"Month\")[\"Seasonal\"]\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "month_names = [\n",
    "    \"January\", \"February\", \"March\", \"April\",\n",
    "    \"May\", \"June\", \"July\", \"August\",\n",
    "    \"September\", \"October\", \"November\", \"December\"\n",
    "]\n",
    "\n",
    "average_seasonal_effect.index = month_names\n",
    "\n",
    "print(\"\\nAverage Seasonal Effect for Each Month:\")\n",
    "display(\n",
    "    average_seasonal_effect.to_frame(\n",
    "        \"Average Seasonal Effect (ppm)\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Task 9: Average CO2 concentration by month\n",
    "# ============================================================\n",
    "\n",
    "monthly_average = (\n",
    "    co2\n",
    "    .groupby(co2.index.month)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "monthly_average.index = month_names\n",
    "\n",
    "print(\"\\nAverage CO₂ Concentration by Month:\")\n",
    "\n",
    "display(\n",
    "    monthly_average.to_frame(\n",
    "        \"Average CO₂ Concentration (ppm)\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Plot average CO2 concentration by month\n",
    "# ============================================================\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "plt.bar(\n",
    "    monthly_average.index,\n",
    "    monthly_average.values\n",
    ")\n",
    "\n",
    "plt.title(\"Average CO₂ Concentration by Month\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Average CO₂ Concentration (ppm)\")\n",
    "\n",
    "plt.xticks(rotation=45)\n",
    "\n",
    "plt.grid(axis=\"y\")\n",
    "\n",
    "plt.show()"
   ]
